# Example values only. Replace the password with the one set for your local role.
DATABASE_URL='postgresql+psycopg://elementary:replace-me@localhost:5432/elementary'
TEST_DATABASE_URL='postgresql+psycopg://elementary:replace-me@localhost:5432/elementary_test'

# Public Auth0 settings. Use the same hostname as the frontend, without https://.
AUTH0_DOMAIN='YOUR_TENANT.auth0.com'
AUTH0_AUDIENCE='https://api.elementary.local'
