# Public Auth0 SPA identifiers only. Never add a Client Secret here.
# Domain is a hostname without https:// or a path.
AUTH0_DOMAIN=YOUR_TENANT.auth0.com
AUTH0_CLIENT_ID=YOUR_CLIENT_ID
AUTH0_AUDIENCE=https://api.elementary.local

# Backend address; separate from the Auth0 audience identifier. Defaults to this URL.
API_BASE_URL=http://localhost:8000
